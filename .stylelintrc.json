{
  "extends": [
    "stylelint-config-standard",
    "stylelint-config-css-modules"
  ],
  "ignoreFiles": [
    "**/dist/**",
    "**/node_modules/**",
    "**/storybook-static/**"
  ],
  "rules": {
    "selector-class-pattern": [
      "^[a-z][a-zA-Z0-9]*$",
      {
        "message": "Use camelCase class names (CSS Modules: styles.sectionTitle)"
      }
    ]
  }
}
