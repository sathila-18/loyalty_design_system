{
  "name": "@finspace-loyalty/ui",
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/sathila-18/loyalty_design_system.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.css": "./dist/index.css",
    "./styles.css": "./dist/styles.css",
    "./components.css": "./dist/components.css",
    "./theme.css": "./src/styles/theme.css"
  },
  "files": [
    "dist",
    "src/styles/theme.css"
  ],
  "scripts": {
    "build": "pnpm icons && vite build && vite build -c vite.styles.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm icons && vitest run",
    "test:watch": "pnpm icons && vitest",
    "icons": "node scripts/subset-icons.ts && node scripts/copy-flags.ts && node scripts/tailwind-theme.ts",
    "payment-icons": "node scripts/update-payment-icons.ts",
    "dial-codes": "node scripts/dial-codes.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@floating-ui/react-dom": "2.1.9",
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "flag-icons": "7.5.0",
    "harfbuzzjs": "1.6.2",
    "jsdom": "30.1.1",
    "libphonenumber-js": "1.13.3",
    "material-symbols": "0.47.5",
    "postcss": "8.5.28",
    "postcss-custom-media": "12.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "stylelint": "17.16.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.2",
    "wawoff2": "2.0.1"
  },
  "dependencies": {
    "@finspace-loyalty/tokens": "workspace:*"
  }
}
